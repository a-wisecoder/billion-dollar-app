@immutable
class CashflowState {
  const CashflowState({
    required this.items,
    this.selectedCategory,
    this.showAnnual = false,
    this.monthlyBudgetCents = 20000, // $200.00 default target ceiling
  });

  final List<Subscription> items;
  final SubscriptionCategory? selectedCategory;
  final bool showAnnual;
  final int monthlyBudgetCents;

  int get activeMonthlyCents => items
      .where((e) => !e.isSimulatedPaused)
      .fold(0, (sum, e) => sum + e.monthlyCents);

  int get activeAnnualCents => items
      .where((e) => !e.isSimulatedPaused)
      .fold(0, (sum, e) => sum + e.annualCents);

  int get simulatedAnnualSavingsCents => items
      .where((e) => e.isSimulatedPaused)
      .fold(0, (sum, e) => sum + e.annualCents);

  int get displayedTotalCents =>
      showAnnual ? activeAnnualCents : activeMonthlyCents;

  double get budgetUsageRatio => monthlyBudgetCents <= 0
      ? 0
      : (activeMonthlyCents / monthlyBudgetCents).clamp(0.0, 1.5);

  List<Subscription> get visibleItems {
    final list = selectedCategory == null
        ? List<Subscription>.of(items)
        : items.where((e) => e.category == selectedCategory).toList();
    list.sort((a, b) => a.daysUntilRenewal.compareTo(b.daysUntilRenewal));
    return list;
  }

  List<DialSegment> get dialSegments {
    final totals = <SubscriptionCategory, int>{};
    for (final sub in items) {
      if (sub.isSimulatedPaused) continue;
      final value = showAnnual ? sub.annualCents : sub.monthlyCents;
      totals[sub.category] = (totals[sub.category] ?? 0) + value;
    }
    final grandTotal = totals.values.fold(0, (a, b) => a + b);
    if (grandTotal == 0) return const [];

    final sortedEntries = totals.entries.toList()
      ..sort((a, b) => b.value.compareTo(a.value));

    return sortedEntries
        .map(
          (e) => DialSegment(
            category: e.key,
            amountCents: e.value,
            fraction: e.value / grandTotal,
          ),
        )
        .toList(growable: false);
  }

  CashflowState copyWith({
    List<Subscription>? items,
    SubscriptionCategory? Function()? selectedCategory,
    bool? showAnnual,
    int? monthlyBudgetCents,
  }) {
    return CashflowState(
      items: items ?? this.items,
      selectedCategory: selectedCategory != null
          ? selectedCategory()
          : this.selectedCategory,
      showAnnual: showAnnual ?? this.showAnnual,
      monthlyBudgetCents: monthlyBudgetCents ?? this.monthlyBudgetCents,
    );
  }
}

