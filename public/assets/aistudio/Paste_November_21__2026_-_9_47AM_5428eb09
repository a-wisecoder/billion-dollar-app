import 'package:flutter/material.dart';

enum BillingCycle {
  weekly('Weekly', '/wk'),
  monthly('Monthly', '/mo'),
  yearly('Yearly', '/yr');

  const BillingCycle(this.label, this.shortSuffix);
  final String label;
  final String shortSuffix;
}

enum SubscriptionCategory {
  aiAndCloud('AI & Cloud', Color(0xFF6366F1), Icons.cloud_outlined),
  streaming('Media', Color(0xFFEC4899), Icons.play_circle_outline),
  productivity('Productivity', Color(0xFF06B6D4), Icons.bolt_outlined),
  utilities('Utilities', Color(0xFFF59E0B), Icons.wifi_rounded),
  health('Health', Color(0xFF10B981), Icons.favorite_outline);

  const SubscriptionCategory(this.label, this.color, this.icon);
  final String label;
  final Color color;
  final IconData icon;
}

@immutable
class Subscription {
  const Subscription({
    required this.id,
    required this.name,
    required this.amountCents,
    required this.cycle,
    required this.category,
    required this.nextBillingDate,
    this.isSimulatedPaused = false,
  });

  final String id;
  final String name;
  final int amountCents;
  final BillingCycle cycle;
  final SubscriptionCategory category;
  final DateTime nextBillingDate;
  final bool isSimulatedPaused;

  /// Normalized monthly cost in minor units.
  int get monthlyCents => switch (cycle) {
        BillingCycle.weekly => (amountCents * 52 / 12).round(),
        BillingCycle.monthly => amountCents,
        BillingCycle.yearly => (amountCents / 12).round(),
      };

  /// Normalized annual cost in minor units.
  int get annualCents => switch (cycle) {
        BillingCycle.weekly => amountCents * 52,
        BillingCycle.monthly => amountCents * 12,
        BillingCycle.yearly => amountCents,
      };

  /// Calendar-accurate days until next charge (avoids hour-of-day off-by-one bugs).
  int get daysUntilRenewal {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);
    final due = DateTime(
      nextBillingDate.year,
      nextBillingDate.month,
      nextBillingDate.day,
    );
    return due.difference(today).inDays;
  }

  Subscription copyWith({
    String? id,
    String? name,
    int? amountCents,
    BillingCycle? cycle,
    SubscriptionCategory? category,
    DateTime? nextBillingDate,
    bool? isSimulatedPaused,
  }) {
    return Subscription(
      id: id ?? this.id,
      name: name ?? this.name,
      amountCents: amountCents ?? this.amountCents,
      cycle: cycle ?? this.cycle,
      category: category ?? this.category,
      nextBillingDate: nextBillingDate ?? this.nextBillingDate,
      isSimulatedPaused: isSimulatedPaused ?? this.isSimulatedPaused,
    );
  }
}
