class InteractiveBurnDial extends StatefulWidget {
  const InteractiveBurnDial({
    super.key,
    required this.segments,
    required this.selectedCategory,
    required this.totalCents,
    required this.showAnnual,
    required this.onSelectCategory,
    required this.onTogglePeriod,
  });

  final List<DialSegment> segments;
  final SubscriptionCategory? selectedCategory;
  final int totalCents;
  final bool showAnnual;
  final ValueChanged<SubscriptionCategory?> onSelectCategory;
  final VoidCallback onTogglePeriod;

  @override
  State<InteractiveBurnDial> createState() => _InteractiveBurnDialState();
}

class _InteractiveBurnDialState extends State<InteractiveBurnDial> {
  static const double _dialSize = 256;

  void _handleRingTouch(Offset localPosition, {required bool isTap}) {
    if (widget.segments.isEmpty) return;

    const center = Offset(_dialSize / 2, _dialSize / 2);
    final dx = localPosition.dx - center.dx;
    final dy = localPosition.dy - center.dy;
    final distance = math.sqrt(dx * dx + dy * dy);

    // Tapping inside the center core toggles Monthly <-> Annual or resets filter.
    if (distance < 72) {
      if (isTap) {
        HapticFeedback.mediumImpact();
        if (widget.selectedCategory != null) {
          widget.onSelectCategory(null);
        } else {
          widget.onTogglePeriod();
        }
      }
      return;
    }

    // Outside ring bounds -> ignore.
    if (distance > (_dialSize / 2) + 12) return;

    // Convert touch coordinates to clockwise angle starting at 12 o'clock (0..2π).
    var touchAngle = math.atan2(dy, dx) + math.pi / 2;
    if (touchAngle < 0) touchAngle += 2 * math.pi;

    double cursor = 0;
    for (final segment in widget.segments) {
      final sweep = segment.fraction * 2 * math.pi;
      if (touchAngle >= cursor && touchAngle <= cursor + sweep) {
        if (isTap && widget.selectedCategory == segment.category) {
          HapticFeedback.lightImpact();
          widget.onSelectCategory(null);
        } else if (widget.selectedCategory != segment.category) {
          HapticFeedback.selectionClick();
          widget.onSelectCategory(segment.category);
        }
        return;
      }
      cursor += sweep;
    }
  }

  @override
  Widget build(BuildContext context) {
    final c = context.vaultColors;

    final activeSegment = widget.selectedCategory == null
        ? null
        : widget.segments
            .where((s) => s.category == widget.selectedCategory)
