class _BurnDialPainter extends CustomPainter {
  const _BurnDialPainter({
    required this.segments,
    required this.selectedCategory,
    required this.trackColor,
  });

  final List<DialSegment> segments;
  final SubscriptionCategory? selectedCategory;
  final Color trackColor;

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final baseRadius = (size.width / 2) - 22;

    // Subtle background track
    final trackPaint = Paint()
      ..color = trackColor
      ..style = PaintingStyle.stroke
      ..strokeWidth = 18;
    canvas.drawCircle(center, baseRadius, trackPaint);

    if (segments.isEmpty) return;

    final gap = segments.length > 1 ? 0.065 : 0.0;
    double startAngle = -math.pi / 2;

    for (final seg in segments) {
      final rawSweep = seg.fraction * 2 * math.pi;
      final sweep = math.max(0.02, rawSweep - gap);
      final isSelected = selectedCategory == seg.category;
      final isDimmed = selectedCategory != null && !isSelected;

      final strokeWidth = isSelected ? 24.0 : 18.0;
      final radius = isSelected ? baseRadius + 4 : baseRadius;
      final rect = Rect.fromCircle(center: center, radius: radius);

      // Ambient neon glow for active/selected arc
      if (!isDimmed) {
        final glowPaint = Paint()
          ..color = seg.category.color
              .withValues(alpha: isSelected ? 0.45 : 0.18)
          ..style = PaintingStyle.stroke
          ..strokeWidth = strokeWidth + 8
          ..strokeCap = StrokeCap.round
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 10);
        canvas.drawArc(rect, startAngle + gap / 2, sweep, false, glowPaint);
      }

      final arcPaint = Paint()
        ..color = isDimmed
            ? seg.category.color.withValues(alpha: 0.22)
            : seg.category.color
        ..style = PaintingStyle.stroke
        ..strokeWidth = strokeWidth
        ..strokeCap = StrokeCap.round;

      canvas.drawArc(rect, startAngle + gap / 2, sweep, false, arcPaint);
      startAngle += rawSweep;
    }
  }

  @override
  bool shouldRepaint(covariant _BurnDialPainter oldDelegate) {
    return oldDelegate.selectedCategory != selectedCategory ||
        oldDelegate.trackColor != trackColor ||
        !listEquals(oldDelegate.segments, segments);
  }
}
