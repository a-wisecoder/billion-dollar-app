  void selectCategory(SubscriptionCategory? category) {
    if (state.selectedCategory == category) return;
    state = state.copyWith(selectedCategory: () => category);
  }

  void toggleAnnualView() {
    state = state.copyWith(showAnnual: !state.showAnnual);
  }

  void toggleSimulatePause(String id) {
    final updated = [
      for (final item in state.items)
        if (item.id == id)
          item.copyWith(isSimulatedPaused: !item.isSimulatedPaused)
        else
          item,
    ];
    _commit(updated);
  }

  void resetAllSimulations() {
    final updated = [
      for (final item in state.items) item.copyWith(isSimulatedPaused: false),
    ];
    _commit(updated);
  }

  void addSubscription(Subscription subscription) {
    _commit([...state.items, subscription]);
  }

  Subscription? removeSubscription(String id) {
    final index = state.items.indexWhere((e) => e.id == id);
    if (index == -1) return null;
    final removed = state.items[index];
    final updated = List<Subscription>.of(state.items)..removeAt(index);
    _commit(updated);
    return removed;
  }

  void restoreSubscription(Subscription sub) {
    if (state.items.any((e) => e.id == sub.id)) return;
    _commit([...state.items, sub]);
  }

  void updateMonthlyBudget(int newBudgetCents) {
    state = state.copyWith(monthlyBudgetCents: newBudgetCents);
  }

  void _commit(List<Subscription> updated) {
    ref.read(cashflowRepositoryProvider).saveAll(updated);
    // Clear selected category filter if that category no longer has active items.
    final selected = state.selectedCategory;
    final keepSelected = selected != null &&
        updated.any((e) => e.category == selected);
    state = state.copyWith(
      items: updated,
      selectedCategory: () => keepSelected ? selected : null,
    );
  }
}

final cashflowProvider = NotifierProvider<CashflowNotifier, CashflowState>(
  CashflowNotifier.new,
);
