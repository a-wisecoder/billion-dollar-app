class MoneyFormatter {
  const MoneyFormatter._();

  /// Formats integer minor units (e.g., 1499 -> "$14.99") with thousands separators.
  static String formatCents(
    int cents, {
    String symbol = '\$',
    bool showDecimals = true,
  }) {
    final isNegative = cents < 0;
    final absCents = cents.abs();
    final whole = absCents ~/ 100;
    final fraction = absCents % 100;

    final wholeStr = _addThousandsSeparators(whole.toString());
    final sign = isNegative ? '-' : '';

    if (!showDecimals && fraction == 0) {
      return '$sign$symbol$wholeStr';
    }
    final fracStr = fraction.toString().padLeft(2, '0');
    return '$sign$symbol$wholeStr.$fracStr';
  }

  static String _addThousandsSeparators(String digits) {
    final buffer = StringBuffer();
    for (var i = 0; i < digits.length; i++) {
      final positionFromRight = digits.length - i;
      buffer.write(digits[i]);
      if (positionFromRight > 1 && positionFromRight % 3 == 1) {
        buffer.write(',');
      }
    }
    return buffer.toString();
  }
}
