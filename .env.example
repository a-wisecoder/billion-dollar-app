# VaultFlow stores subscription data locally in the browser.

# Public site canonical base URL (used at build time for canonical links, Open Graph, sitemap.xml, and robots.txt)
SITE_URL=https://vaultflow.app

# Billing & license validation (Polar Customer Portal — public values only, never put private API keys here)
# Allowed values: polar | dev (dev is stripped from production builds)
VITE_LICENSE_PROVIDER=polar
VITE_POLAR_ORG_ID=
VITE_POLAR_CHECKOUT_YEARLY=
VITE_POLAR_CHECKOUT_LIFETIME=
VITE_LAUNCH_PRICE=0
VITE_MOR_NAME=Polar

# Optional cookie-less analytics (Plausible or Umami). Both must be set to load the script.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
