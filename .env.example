# VaultFlow stores subscription data locally in the browser.
# Billing & license validation (Polar Customer Portal — public values only, never put private API keys here)
# Allowed values: polar | dev (dev is stripped from production builds)
VITE_LICENSE_PROVIDER=polar
VITE_POLAR_ORG_ID=
VITE_POLAR_CHECKOUT_YEARLY=
VITE_POLAR_CHECKOUT_LIFETIME=
VITE_LAUNCH_PRICE=0
VITE_MOR_NAME=Polar
